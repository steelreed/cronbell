# Cronbell settings for deploy/docker-compose.yml. Copy to .env, fill in, and keep it private:
#
#   cp .env.example .env && chmod 600 .env
#
# Every value below is a placeholder. Lines starting with # are off; remove the # to use one.
# Leave optional variables commented out rather than empty: an empty value is not a default.

# --- Required ---------------------------------------------------------------------------

# Domain name pointed at this server (DNS A/AAAA record). Caddy gets its certificate for it,
# and alerts link to https://<domain>/checks/<slug>.
CRONBELL_DOMAIN=cron.example.com

# Image tag: "latest", or a release such as 0.1.0 to upgrade only when you choose.
CRONBELL_VERSION=latest

# --- First start only ---------------------------------------------------------------------

# Admin account, created on first start when none exists. Without these, the first visit to
# the dashboard shows a one-time setup page instead. Password: 8 to 128 characters. Once the
# account exists these are ignored; you may remove them.
CRONBELL_ADMIN_EMAIL=admin@example.com
CRONBELL_ADMIN_PASSWORD=change-me-to-a-long-password

# API key of the Default project, at least 20 characters. Unset, the server makes one and
# prints it to the log once (docker compose logs cronbell). More keys: dashboard, API keys.
# CRONBELL_API_KEY=cb_replace_with_a_random_string

# --- Alerts by email (optional) -------------------------------------------------------------

# How long pings and alert deliveries are kept (default 90d). Older ones are pruned daily.
# CRONBELL_HISTORY_RETENTION=90d

# Without CRONBELL_SMTP_HOST, email channels cannot be created. Telegram, Slack and webhook
# channels need no server settings.
# CRONBELL_SMTP_HOST=smtp.example.com
# 587 uses STARTTLS, 465 implicit TLS.
# CRONBELL_SMTP_PORT=587
# CRONBELL_SMTP_USERNAME=cronbell@example.com
# CRONBELL_SMTP_PASSWORD=smtp-password
# Sender of alert emails. Defaults to the username when that is an address.
# CRONBELL_SMTP_FROM=Cronbell <cronbell@example.com>
# Set to false only for a local relay without TLS.
# CRONBELL_SMTP_STARTTLS=true

# --- Other (optional) ---------------------------------------------------------------------

# PostgreSQL instead of the bundled SQLite file. Backups are then pg_dump's job, not backup.sh.
# CRONBELL_DATABASE_URL=postgres://cronbell:password@db.example.com:5432/cronbell?sslmode=require

# Idle time after which a dashboard session ends.
# CRONBELL_SESSION_TIMEOUT=7d
